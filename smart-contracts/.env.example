# ===========================================
# Account Configuration
# ===========================================

# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Contract owner address
OWNER_ADDRESS=

# BridgeForwarder caller address (service wallet)
CALLER_ADDRESS=

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ===========================================
# RPC URLs
# ===========================================

ZKSYNC_ERA_RPC_URL=
ZKSYNC_SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# ===========================================
# LayerZero V2 Endpoints
# See: https://docs.layerzero.network/v2/developers/evm/technical-reference/deployed-contracts
# ===========================================

# Set this for the selected Hardhat network.
LAYERZERO_ENDPOINT=

# ===========================================
# LayerZero Chain IDs (EIDs)
# ===========================================

# Set these explicitly for the linked source and destination networks.
DESTINATION_LAYERZERO_EID=
SOURCE_LAYERZERO_EID=

# ===========================================
# Deployed Contract Addresses
# ===========================================

# zkSync Sepolia contracts
BRIDGE_FORWARDER_ADDRESS=
BRIDGE_RECEIVER_ADDRESS=

# Hub receiver address used when deploying the target sender
HUB_BRIDGE_RECEIVER_ADDRESS=

# Base Sepolia contracts
BRIDGE_SENDER_ADDRESS=

# ===========================================
# Configuration Script Variables
# ===========================================

# For set-forwarder-bridge.ts (GL -> EVM direction)
DST_EID=
DST_BRIDGE_ADDRESS=

# For set-trusted-forwarder.ts (EVM -> GL direction)
SRC_EID=
TRUSTED_FORWARDER_ADDRESS=

# For set-authorized-relayer.ts
RELAYER_ADDRESS=

# ===========================================
# Test Script Variables
# ===========================================

# GenLayer target contract for send-test-message.ts
TARGET_CONTRACT=
