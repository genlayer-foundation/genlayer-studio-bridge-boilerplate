# ===========================================
# Account Configuration
# ===========================================

# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Contract owner address
OWNER_ADDRESS=

# Service/relayer wallet
CALLER_ADDRESS=
RELAYER_ADDRESS=

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ===========================================
# RPC URLs
# ===========================================

ZKSYNC_ERA_RPC_URL=https://mainnet.era.zksync.io
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ===========================================
# LayerZero V2 Endpoints
# See: https://docs.layerzero.network/v2/deployments/deployed-contracts
# ===========================================

# zkSync Sepolia (different due to zkEVM CREATE2)
ZKSYNCSEPOLIATESTNET_ENDPOINT=0xe2Ef622A13e71D9Dd2BBd12cd4b27e1516FA8a09
BASESEPOLIATESTNET_ENDPOINT=0x6EDCE65403992e310A62460808c4b910D972f10f

# ===========================================
# LayerZero Chain IDs (EIDs)
# ===========================================

# Base Sepolia is the recommended bidirectional Solana smoke-test hub.
# zkSync Sepolia is 40305, but Solana -> zkSync Sepolia depends on
# LayerZero Devnet pricefeed support for route 10305.
HUB_EID=40245
ZKSYNC_EID=40305
SOLANA_EID=40168
GENLAYER_EID=61998

# ===========================================
# Deployed Contract Addresses
# ===========================================

# New role-named contracts
HUB_OUTBOUND_ROUTER_ADDRESS=
HUB_INBOUND_INBOX_ADDRESS=
EVM_CHAIN_OUTBOX_ADDRESS=
EVM_CHAIN_INBOX_ADDRESS=

# Legacy contract names
BRIDGE_FORWARDER_ADDRESS=
BRIDGE_RECEIVER_ADDRESS=
ZKSYNC_BRIDGE_RECEIVER_ADDRESS=
BRIDGE_SENDER_ADDRESS=

# ===========================================
# Configuration Script Variables
# ===========================================

# GenLayer -> destination direction.
# For EVM destinations use an EVM address. For Solana destinations use the
# destination OApp Store PDA as 0x-prefixed bytes32.
DST_EID=40245
DST_ENDPOINT_ADDRESS=
DST_BRIDGE_ADDRESS=
SOLANA_TEST_RECEIVER_TARGET_BYTES32=
SOLANA_LZ_RECEIVE_GAS=1000000
SOLANA_LZ_RECEIVE_VALUE=0

# source chain -> GenLayer direction.
# TRUSTED_SOURCE_ENDPOINT_ADDRESS also accepts either an EVM address or 0x bytes32.
# For Solana sources, use the OApp Store PDA bytes32, not the program id.
SRC_EID=40245
TRUSTED_SOURCE_ENDPOINT_ADDRESS=
TRUSTED_FORWARDER_ADDRESS=

# ===========================================
# Test Script Variables
# ===========================================

# GenLayer target contract for send-test-message.ts
TARGET_CONTRACT=
