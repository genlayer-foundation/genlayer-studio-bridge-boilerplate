SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=../../.testnet-keys/solana-devnet.json
SOLANA_PROGRAM_KEYPAIR_PATH=target/deploy/bridge_endpoint-keypair.json
SOLANA_PROGRAM_SO_PATH=target/deploy/bridge_endpoint.so
SOLANA_DEPLOY_BUFFER_KEYPAIR_PATH=../../.testnet-keys/solana-deploy-buffer.json
LAYERZERO_SOLANA_ENDPOINT_PROGRAM_ID=76y77prsiCMvXMjuoZ5VRrhG5qYBrUMYTE5WgHqgjEn6
SOLANA_EID=40168
# Base Sepolia is the recommended bidirectional Solana smoke-test hub.
# zkSync Sepolia is 40305, but Solana -> zkSync Sepolia depends on
# LayerZero Devnet pricefeed support for route 10305.
HUB_EID=40245

# Filled after hub deployment.
HUB_OUTBOUND_ROUTER_ADDRESS=
HUB_INBOUND_INBOX_ADDRESS=

# Optional test receiver registration for real LayerZero delivery smoke tests.
SOLANA_REGISTER_TEST_RECEIVER=1
SOLANA_TEST_RECEIVER_TARGET=
SOLANA_TEST_RECEIVER_MODE=1

# Optional Solana -> hub smoke message settings. The target is opaque bytes32;
# use a GenLayer receiver identity when running a full relay smoke.
SOLANA_TO_HUB_TARGET_BYTES32=
SOLANA_TO_HUB_TARGET=
SOLANA_TO_HUB_PAYLOAD=
SOLANA_TO_HUB_LZ_RECEIVE_GAS=250000
SOLANA_TO_HUB_LZ_RECEIVE_VALUE=0
SOLANA_TO_HUB_COMPUTE_UNITS=1000000
