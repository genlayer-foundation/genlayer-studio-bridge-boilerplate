# Select exactly one supported profile. No default is used.
BRIDGE_NETWORK_PROFILE=bradbury
GENLAYER_CHAIN_ID=4221
DEPLOYMENT_MANIFEST=

# GenLayer -> EVM
BRIDGE_SENDER_ADDRESS=
TARGET_BRIDGE_SENDER_ADDRESS=
BRIDGE_FORWARDER_ADDRESS=
GENLAYER_RPC_URL=https://studio.genlayer.com/api
PRIVATE_KEY=
BRIDGE_SYNC_INTERVAL="*/5 * * * *"

# Hub EVM network
HUB_RPC_URL=
HUB_CHAIN_ID=
HUB_LAYERZERO_EID=
HUB_BRIDGE_RECEIVER_ADDRESS=

# EVM -> GenLayer
BRIDGE_RECEIVER_IC_ADDRESS=
EVM_TO_GL_SYNC_INTERVAL="*/1 * * * *"

# Target EVM network
TARGET_RPC_URL=
TARGET_CHAIN_ID=
TARGET_LAYERZERO_EID=
TARGET_BRIDGE_RECEIVER_ADDRESS=

# Base (Optional but used in cli.ts)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
